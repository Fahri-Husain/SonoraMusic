<?xml version="1.0" encoding="utf-8"?>
<!--
   Aturan backup dan transfer perangkat (Android 12 ke atas).
   File audio unduhan besar dan bisa diunduh ulang, jadi tidak ikut dipindahkan.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="downloads.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="downloads.json" />
    </device-transfer>
</data-extraction-rules>